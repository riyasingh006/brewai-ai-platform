// Coffee Shop AI Agent — canonical database schema.
// Target: PostgreSQL (production). A dev SQLite variant is produced from
// this file by backend/scripts/to_sqlite.py (swaps provider + URL).
//
// Notes:
//   - No native enums are used so the same models work on SQLite and Postgres.
//   - IDs are cuid strings (Clerk user IDs are stable strings we store 1:1).
//   - Money is stored as Float (menu prices are decimals); totals are
//     computed server-side and rounded to 2 places before persisting.

generator client {
  provider = "prisma-client-py"
  interface = "sync"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Identity

model User {
  id           String       @id // Clerk user id in production
  email        String       @unique
  name         String?
  imageUrl     String?
  role         String       @default("customer") // customer | barista | admin
  passwordHash String?      @map("password_hash") // PBKDF2 hash for first-party login (optional)
  phone        String?
  birthday     DateTime?
  loyaltyPoints Int         @default(0)
  referralCode String?      @unique
  referredById String?      @map("referred_by_id")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  orders       Order[]
  favorites    Favorite[]
  addresses    Address[]
  savedCards   SavedCard[]
  coupons      UserCoupon[]
  sessions     ChatSession[]
  reviews      Review[]
  cartItems    CartItem[]
  events       AnalyticsEvent[]

  @@map("users")
}

model Favorite {
  id         Int      @id @default(autoincrement())
  userId     String
  menuItemId Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([userId, menuItemId])
  @@map("favorites")
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    String
  label     String // home | work | cafe
  line1     String
  line2     String?
  city      String
  state     String?
  zip       String?
  country   String   @default("IN")
  isDefault Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])

  @@map("addresses")
}

model SavedCard {
  id        Int     @id @default(autoincrement())
  userId    String
  brand     String // visa | mastercard | rupay | amex
  last4     String
  expiry    String // MM/YY
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id])

  @@map("saved_cards")
}

model Referral {
  id          Int      @id @default(autoincrement())
  referrerId  String
  refereeId   String
  rewardPoints Int     @default(50)
  createdAt   DateTime @default(now())

  @@map("referrals")
}

model AnalyticsEvent {
  id        Int      @id @default(autoincrement())
  event     String // order_placed | item_viewed | searched | message_sent
  userId    String?
  payload   String   @default("{}") // JSON string
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([event, createdAt])
  @@map("analytics_events")
}

// ------------------------------------------------------------------- Menu

model MenuItem {
  id          Int      @id
  name        String
  category    String // Coffee | Cold Coffee | Tea | ... (matches data/menu.json)
  price       Float
  description String
  available   Boolean  @default(true)
  imageUrl    String?
  tags        String   @default("[]") // JSON: ["popular", "new", "seasonal"]
  calories    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  favorites  Favorite[]
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([category])
  @@index([available])
  @@map("menu_items")
}

// ------------------------------------------------------------------- Chat

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  messages  ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  sessionId String
  role      String // user | assistant
  content   String
  toolName  String? // menu intent that answered the message (if any)
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, id])
  @@map("chat_messages")
}

// ----------------------------------------------------------------- Cart

model CartItem {
  id            Int      @id @default(autoincrement())
  userId        String
  menuItemId    Int
  name          String // snapshot
  unitPrice     Float // snapshot
  quantity      Int      @default(1)
  customization String   @default("{}") // JSON: milk, sugar, ice, size, toppings
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([userId])
  @@map("cart_items")
}

// ----------------------------------------------------------------- Orders

model Order {
  id            String     @id @default(cuid())
  orderNumber   String     @unique // human readable: CS-2026-XXXXXX
  userId        String
  status        String     @default("pending") // pending|confirmed|preparing|ready|completed|cancelled
  paymentMethod String     // upi | card | cash | wallet
  paymentStatus String     @default("pending") // pending|paid|failed|refunded
  subtotal      Float
  discount      Float      @default(0)
  tax           Float      @default(0)
  total         Float
  couponCode    String?
  tip           Float      @default(0)
  notes         String?
  estMinutes    Int        @default(10)
  createdAt     DateTime   @default(now())
  completedAt   DateTime?
  user          User       @relation(fields: [userId], references: [id])
  items         OrderItem[]
  receipt       Receipt?
  review        Review?

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  orderId       String
  menuItemId    Int?
  name          String
  unitPrice     Float
  quantity      Int
  customization String   @default("{}")
  order         Order    @relation(fields: [orderId], references: [id])
  menuItem      MenuItem? @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Receipt {
  id            String   @id @default(cuid())
  orderId       String   @unique
  invoiceNumber String   @unique
  qrCode        String // data embedded in the QR on the PDF
  pdfUrl        String?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id])

  @@map("receipts")
}

model Review {
  id        Int      @id @default(autoincrement())
  orderId   String   @unique
  userId    String
  rating    Int // 1..5
  comment   String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@map("reviews")
}

// ---------------------------------------------------------------- Coupons

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  discountType  String // percentage | fixed
  discountValue Float
  minOrder      Float        @default(0)
  maxDiscount   Float?
  startsAt      DateTime?
  expiresAt     DateTime?
  usageLimit    Int?
  usageCount    Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  redemptions   UserCoupon[]

  @@map("coupons")
}

model UserCoupon {
  id         Int      @id @default(autoincrement())
  userId     String
  couponId   String
  redeemedAt DateTime @default(now())
  used       Boolean  @default(false)
  usedAt     DateTime?
  user       User     @relation(fields: [userId], references: [id])
  coupon     Coupon   @relation(fields: [couponId], references: [id])

  @@unique([userId, couponId])
  @@map("user_coupons")
}

model Festival {
  id          String  @id @default(cuid())
  name        String
  emoji       String
  description String?
  theme       String?
  startsAt    DateTime
  endsAt      DateTime

  @@map("festivals")
}
