# Google Maps JavaScript API key (required for the Nearby Cafés feature).
# Get one from https://developers.google.com/maps/documentation/javascript/get-api-key
# Enable these APIs in Google Cloud Console: Maps JavaScript API, Places API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
MODEL_NAME=gemini-3.6-flash
