# ---------------------------------------------------------------------------
# BrewAI environment template. Copy to ".env" and fill in real values.
# Never commit the real ".env" — it is gitignored.
# ---------------------------------------------------------------------------

# --- Google APIs -----------------------------------------------------------
# Maps JavaScript API key (required for the Nearby Cafés feature).
# Enable these APIs in Google Cloud Console: Maps JavaScript API, Places API.
# https://developers.google.com/maps/documentation/javascript/get-api-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model (default: gemini-3.6-flash)
MODEL_NAME=gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash
# Optional: comma-separated fallback models tried when the primary is rate-limited
# GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-flash-latest

# --- Authentication (first-party) -----------------------------------------
# Secrets are read ONLY from the server environment — never from frontend code
# or API responses. The values you choose here MUST match across deployments.
# AUTH_SECRET signs the session JWTs and is shared with the frontend proxy
# (frontend/.env.local must contain the SAME value).
AUTH_SECRET=
# Gates admin account creation at /api/auth/admin/register.
ADMIN_SECRET_KEY=
# Dev-time admin password used to bootstrap the admin account at startup.
ADMIN_DEV_PASSWORD=
# Email promoted to "admin" at startup (default: admin@coffeeshop.local).
# ADMIN_EMAIL=admin@coffeeshop.local
# Optional: require a secret to bootstrap admins even in non-production.
# ADMIN_BOOTSTRAP_SECRET=
# Session JWT lifetime in seconds (default: 604800 = 7 days).
# SESSION_TTL_SECONDS=604800

# --- Environment / runtime --------------------------------------------------
# development | production
APP_ENV=development
# SQLite file URL is the default; swap for your production DB when deployed.
DATABASE_URL=file:./backend/prisma/dev.db
# Comma-separated list of allowed browser origins (default: http://localhost:3000).
CORS_ORIGINS=http://localhost:3000
# Canonical frontend origin, used for redirects/links (default: http://localhost:3000).
FRONTEND_URL=http://localhost:3000
# sandbox (default) | stripe | razorpay
PAYMENT_PROVIDER=sandbox
# slowapi rate limit for chat (default: 30/minute)
# CHAT_RATE_LIMIT=30/minute

# --- Loyalty / pricing knobs (defaults shown) ------------------------------
# LOYALTY_POINTS_PER_ORDER=10
# REFERRAL_REWARD_POINTS=50
# BIRTHDAY_COUPON_CODE=BIRTHDAY20
# BIRTHDAY_DISCOUNT=20
# TAX_RATE=0.05

# --- Logging ----------------------------------------------------------------
# LOG_LEVEL=INFO

# --- Optional: Clerk (production auth provider) ----------------------------
# When set, bearer JWTs issued by Clerk are accepted alongside session tokens.
# CLERK_SECRET_KEY=
# CLERK_JWT_KEY=
# CLERK_ISSUER=
# CLERK_WEBHOOK_SECRET=

# --- Optional: real payment gateway (future wiring; sandbox is the default) --
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Frontend-only (put these in frontend/.env.local, not the root .env) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
# AUTH_SECRET=<same value as the root AUTH_SECRET above>
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<client-side Maps key>
